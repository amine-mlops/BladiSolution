# ---------------------------------------------------------------------------
# BladiSolution Campus configuration. Copy to `.env` (repo root for Docker Compose,
# or backend/.env for local development) and adjust. Never commit `.env`.
# ---------------------------------------------------------------------------

# --- Database --------------------------------------------------------------
# Local dev (Postgres from `docker run ... -p 5433:5432`, see README):
DATABASE_URL=postgresql+psycopg://bladi:bladi@localhost:5433/bladisolution
# Docker Compose builds DATABASE_URL from these:
POSTGRES_USER=bladi
POSTGRES_PASSWORD=change-me
POSTGRES_DB=bladisolution

# --- Auth ------------------------------------------------------------------
# REQUIRED in production: a long random string (e.g. `openssl rand -hex 32`).
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRE_HOURS=168
# Set to true when served over HTTPS so the session cookie is Secure.
COOKIE_SECURE=false

# --- AI ----------------------------------------------------------------------
# auto  = use Claude when Anthropic credentials are available, else the local engine
# claude = always try Claude (falls back to the local engine on any failure)
# local  = deterministic local engine only (no network calls)
AI_PROVIDER=auto
# Anthropic API key (optional). Without it, the deterministic local engine is used.
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
AI_TIMEOUT_SECONDS=25

# --- Misc --------------------------------------------------------------------
# Comma-separated origins allowed to call the API cross-origin (not needed when
# the frontend proxies /api, which is the default in dev and Docker).
CORS_ORIGINS=http://localhost:5173
RATE_LIMIT_ENABLED=true
# Identify clients by X-Forwarded-For. Only set to true behind a proxy that overwrites
# it (Docker Compose sets this for the bundled nginx).
TRUST_FORWARDED_FOR=false
# Load the FICTIONAL demo dataset when the database is empty. Keep false anywhere real
# people use the platform: the demo contains made-up users, stars and implementations.
SEED_ON_STARTUP=false
MAX_UPLOAD_MB=5
# Host port for the Docker Compose web app.
APP_PORT=8080
